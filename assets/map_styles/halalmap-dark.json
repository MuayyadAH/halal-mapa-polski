{
  "version": 8,
  "name": "halalmap-dark",
  "metadata": {
    "halalmap:note": "Custom warm dark cocoa basemap over MapTiler OpenMapTiles vector tiles. The {key} placeholder is replaced at runtime with --dart-define=MAP_TILES_KEY (constitution §2; 003-map-screen R17)."
  },
  "glyphs": "https://api.maptiler.com/fonts/{fontstack}/{range}.pbf?key={key}",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://api.maptiler.com/tiles/v3/tiles.json?key={key}"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#1a100e" }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": { "fill-color": "#3f6b5a", "fill-opacity": 0.6 }
    },
    {
      "id": "landcover-green",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["in", "class", "wood", "grass", "scrub", "forest"],
      "paint": { "fill-color": "#3f6b5a", "fill-opacity": 0.35 }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 13,
      "paint": { "fill-color": "#2c1a16", "fill-opacity": 0.7 }
    },
    {
      "id": "road-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["!in", "class", "ferry", "rail", "path"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#3b2622",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 1.2, 14, 7, 18, 22]
      }
    },
    {
      "id": "road",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["!in", "class", "ferry", "rail", "path"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#5b3a2a",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.6, 14, 4.5, 18, 16]
      }
    },
    {
      "id": "road-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 13,
      "layout": {
        "symbol-placement": "line",
        "text-field": "{name}",
        "text-font": ["Noto Sans Regular"],
        "text-size": 9
      },
      "paint": {
        "text-color": "#8d6c4d",
        "text-halo-color": "#1a100e",
        "text-halo-width": 1,
        "text-opacity": 0.85
      }
    },
    {
      "id": "place-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["in", "class", "city", "town", "village", "suburb", "neighbourhood"],
      "layout": {
        "text-field": "{name}",
        "text-font": ["Noto Sans Medium"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 8, 11, 14, 15]
      },
      "paint": {
        "text-color": "#d9c5a3",
        "text-halo-color": "#1a100e",
        "text-halo-width": 1.4
      }
    }
  ]
}
