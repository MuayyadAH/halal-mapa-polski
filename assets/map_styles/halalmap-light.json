{
  "version": 8,
  "name": "halalmap-light",
  "metadata": {
    "halalmap:note": "Custom warm cocoa/cream basemap over MapTiler OpenMapTiles vector tiles. The {key} placeholder is replaced at runtime with --dart-define=MAP_TILES_KEY (constitution §2; 003-map-screen R17)."
  },
  "glyphs": "https://api.maptiler.com/fonts/{fontstack}/{range}.pbf?key={key}",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://api.maptiler.com/tiles/v3/tiles.json?key={key}"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#ece1cb" }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": { "fill-color": "#a8c2c5", "fill-opacity": 0.75 }
    },
    {
      "id": "landcover-green",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["in", "class", "wood", "grass", "scrub", "forest"],
      "paint": { "fill-color": "#b4c89a", "fill-opacity": 0.55 }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": { "fill-color": "#b4c89a", "fill-opacity": 0.5 }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 13,
      "paint": { "fill-color": "#d4c08e", "fill-opacity": 0.5 }
    },
    {
      "id": "road-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["!in", "class", "ferry", "rail", "path"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#e6d6b6",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 1.2, 14, 7, 18, 22]
      }
    },
    {
      "id": "road",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["!in", "class", "ferry", "rail", "path"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#f6ecd5",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.6, 14, 4.5, 18, 16]
      }
    },
    {
      "id": "road-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 13,
      "layout": {
        "symbol-placement": "line",
        "text-field": "{name}",
        "text-font": ["Noto Sans Regular"],
        "text-size": 9
      },
      "paint": {
        "text-color": "#8a6f3e",
        "text-halo-color": "#faf5e9",
        "text-halo-width": 1,
        "text-opacity": 0.85
      }
    },
    {
      "id": "place-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["in", "class", "city", "town", "village", "suburb", "neighbourhood"],
      "layout": {
        "text-field": "{name}",
        "text-font": ["Noto Sans Medium"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 8, 11, 14, 15]
      },
      "paint": {
        "text-color": "#7a5a3f",
        "text-halo-color": "#faf5e9",
        "text-halo-width": 1.4
      }
    }
  ]
}
